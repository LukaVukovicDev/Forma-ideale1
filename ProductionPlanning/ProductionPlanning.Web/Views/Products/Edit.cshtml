@model ProductionPlanning.Web.ViewModels.EditProductViewModel

@{
    ViewData["Title"] = "Izmena proizvoda";
}

<h1>Izmena proizvoda</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="SifraProizvoda" class="form-label"></label>
                <input asp-for="SifraProizvoda" class="form-control" />
                <span asp-validation-for="SifraProizvoda" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Naziv" class="form-label"></label>
                <input asp-for="Naziv" class="form-control" />
                <span asp-validation-for="Naziv" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sačuvaj izmene</button>
            <a asp-action="Index" class="btn btn-secondary">Otkaži</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
