@model ProductionPlanning.Web.ViewModels.EditOperationViewModel

@{
    ViewData["Title"] = "Izmena operacije";
}

<h1>Izmena tehnološke operacije</h1>
<hr />
<div class="row">
    <div class="col-12 col-lg-7">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_OperationFields" model="Model" />
            <button type="submit" class="btn btn-primary">Sačuvaj izmene</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Otkaži</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
