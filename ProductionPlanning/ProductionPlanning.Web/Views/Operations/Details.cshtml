@model ProductionPlanning.Web.ViewModels.OperationDetailsViewModel

@{
    ViewData["Title"] = "Kompatibilnost mašina";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <a asp-action="Index" class="small text-decoration-none">&larr; Nazad na operacije</a>
        <h1 class="mt-2 mb-1">@Model.Name</h1>
        <p class="text-secondary mb-0">@Model.Code · @(Model.IsActive ? "Aktivna operacija" : "Neaktivna operacija")</p>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Izmeni operaciju</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Kompatibilne mašine</h2>
        <p class="text-secondary">Izaberite mašine koje mogu da izvrše ovu operaciju. Neaktivne mašine ostaju evidentirane, ali ne čine rutu spremnom za terminiranje.</p>
        <form asp-action="SaveCapabilities" method="post">
            <input type="hidden" name="OperationDefinitionId" value="@Model.Id" />
            <div class="row g-2">
                @foreach (var machine in Model.Machines)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-check border rounded p-3 ps-5 h-100">
                            <input class="form-check-input" type="checkbox" name="MachineIds"
                                   value="@machine.Id" checked="@machine.IsSelected" />
                            <span class="form-check-label">
                                @machine.Code — @machine.Name
                                @if (!machine.IsActive)
                                {
                                    <span class="badge text-bg-danger ms-1">Neaktivna</span>
                                }
                            </span>
                        </label>
                    </div>
                }
            </div>
            <button type="submit" class="btn btn-primary mt-3">Sačuvaj kompatibilnost</button>
        </form>
    </div>
</section>
