@model ProductionPlanning.Web.ViewModels.CreatePlannedProductionViewModel

@{
    ViewData["Title"] = "Dodavanje plana";
}

<h1>Dodavanje plana proizvodnje</h1>
<hr />

@if (Model.Products.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Nema unetih proizvoda. Prvo dodajte proizvod u modulu
        <a asp-controller="Products" asp-action="Index">Proizvodi</a>.
    </div>
}
@if (Model.Machines.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Nema aktivnih mašina. Prvo dodajte ili aktivirajte mašinu u modulu
        <a asp-controller="Machines" asp-action="Index">Mašine</a>.
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                    <option value="0">Izaberite proizvod</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MachineId" class="form-label"></label>
                <select asp-for="MachineId" asp-items="Model.Machines" class="form-select">
                    <option value="0">Izaberite aktivnu mašinu</option>
                </select>
                <span asp-validation-for="MachineId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlannedDate" class="form-label"></label>
                <input asp-for="PlannedDate" type="date" class="form-control" />
                <span asp-validation-for="PlannedDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlannedQuantity" class="form-label"></label>
                <input asp-for="PlannedQuantity" type="number" min="1" step="1" class="form-control" />
                <span asp-validation-for="PlannedQuantity" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sačuvaj plan</button>
            <a asp-action="Index" class="btn btn-secondary">Otkaži</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
