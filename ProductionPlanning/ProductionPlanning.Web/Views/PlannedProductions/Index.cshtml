@model IEnumerable<ProductionPlanning.Web.ViewModels.PlannedProductionIndexViewModel>

@{
    ViewData["Title"] = "Planirana proizvodnja";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Planirana proizvodnja</h1>
    <a asp-action="Create" class="btn btn-primary">+ Dodaj plan</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID plana</th>
                <th>Šifra proizvoda</th>
                <th>Naziv proizvoda</th>
                <th>Mašina</th>
                <th>Planirani datum</th>
                <th class="text-end">Planirano</th>
                <th class="text-end">Urađeno</th>
                <th class="text-end">Preostalo</th>
                <th>Realizacija</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plan in Model)
            {
                <tr>
                    <td>@plan.Id</td>
                    <td>@plan.ProductCode</td>
                    <td>@plan.ProductName</td>
                    <td>@plan.MachineCode — @plan.MachineName</td>
                    <td>@plan.PlannedDate.ToString("dd.MM.yyyy.")</td>
                    <td class="text-end">@plan.PlannedQuantity</td>
                    <td class="text-end">@plan.TotalProduced</td>
                    <td class="text-end">@plan.RemainingQuantity</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="@(plan.IsOverproduced ? "text-danger fw-semibold" : "")">
                                @plan.CompletionPercentage.ToString("N1")%
                            </span>
                            @if (plan.IsOverproduced)
                            {
                                <span class="badge text-bg-danger">Prekoračenje</span>
                            }
                            <a asp-controller="ProductionRecords"
                               asp-action="Create"
                               asp-route-plannedProductionId="@plan.Id"
                               class="btn btn-sm btn-outline-primary text-nowrap">
                                Evidentiraj
                            </a>
                        </div>
                        <div class="progress mt-2" role="progressbar"
                             aria-label="Procenat realizacije plana @plan.Id"
                             aria-valuenow="@Math.Min(100d, plan.CompletionPercentage).ToString("F0")"
                             aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(plan.IsOverproduced ? "bg-danger" : "")"
                                 style="width: @Math.Min(100d, plan.CompletionPercentage).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
